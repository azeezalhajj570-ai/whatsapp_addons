<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_evolution_instance_qr_wizard_form" model="ir.ui.view">
        <field name="name">evolution.instance.qr.wizard.form</field>
        <field name="model">evolution.instance.qr.wizard</field>
        <field name="arch" type="xml">
            <form string="Scan QR Code" create="0" edit="1" delete="0">
                <header>
                    <button name="action_refresh_qr" type="object" string="Get QR Code" class="oe_highlight"/>
                    <button name="action_get_pairing_code" type="object" string="Get Pairing Code"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="account_id"/>
                            <field name="status"/>
                            <field name="fetched_at"/>
                        </group>
                        <group>
                            <field name="pairing_phone" placeholder="+15551234567"/>
                            <field name="pairing_code" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="qr_code_image" widget="image" options="{'size': [420, 420]}" readonly="1"/>
                    </group>
                    <group>
                        <field name="qr_code_text" readonly="1"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
