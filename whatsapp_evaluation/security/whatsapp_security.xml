<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_whatsapp_evaluation" model="ir.module.category">
        <field name="name">WhatsApp Evaluation</field>
        <field name="description">Helps you handle WhatsApp messages.</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_whatsapp_evaluation_user" model="res.groups">
        <field name="name">User</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_whatsapp_evaluation_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="implied_ids" eval="[(4, ref('group_whatsapp_evaluation_user'))]"/>
    </record>
</odoo>
