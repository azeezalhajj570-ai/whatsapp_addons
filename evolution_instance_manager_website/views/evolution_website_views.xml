<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="evolution_instances_website_page" name="Evolution Instances Website Page">
        <t t-call="website.layout">
            <div class="container my-5">
                <h1 class="mb-4">Evolution Instances</h1>
                <div t-if="success" class="alert alert-success" role="alert">
                    <t t-esc="success"/>
                </div>
                <div t-if="error" class="alert alert-danger" role="alert">
                    <t t-esc="error"/>
                </div>

                <div class="card mb-4">
                    <div class="card-body">
                        <h5 class="card-title mb-3">Create New Instance</h5>
                        <form action="/evolution/instances/create" method="post" class="row g-3">
                            <input type="hidden" name="csrf_token" t-att-value="csrf_token"/>
                            <div class="col-md-5">
                                <label class="form-label">Name</label>
                                <input class="form-control" type="text" name="name" required="required"/>
                            </div>
                            <div class="col-md-5">
                                <label class="form-label">Phone</label>
                                <input class="form-control" type="text" name="pairing_phone" placeholder="+15551234567" required="required"/>
                            </div>
                            <div class="col-md-2 d-flex align-items-end">
                                <button type="submit" class="btn btn-primary w-100">Create</button>
                            </div>
                        </form>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Phone</th>
                                <th>Status</th>
                                <th>Last Sync</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="records" t-as="rec">
                                <tr>
                                    <td><t t-esc="rec.name"/></td>
                                    <td><t t-esc="rec.pairing_phone or '-'"/></td>
                                    <td><t t-esc="rec.status or '-'"/></td>
                                    <td><t t-esc="rec.last_status_sync_at or '-'"/></td>
                                    <td class="text-end">
                                        <div class="dropdown d-inline-block">
                                            <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                                &#8942;
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end">
                                                <t t-if="rec.status != 'open'">
                                                    <li>
                                                        <button type="button" class="dropdown-item js-evo-get-qr" t-att-data-record-id="rec.id" t-att-data-modal-id="'qrModal%s' % rec.id">Get QR</button>
                                                    </li>
                                                </t>
                                                <t t-if="rec.status == 'open'">
                                                    <li>
                                                        <button class="dropdown-item" type="button" t-att-data-bs-target="'#credModal%s' % rec.id" data-bs-toggle="modal">Connection Credentials</button>
                                                    </li>
                                                    <li>
                                                        <form t-attf-action="/evolution/instances/test/{{ rec.id }}" method="post">
                                                            <input type="hidden" name="csrf_token" t-att-value="csrf_token"/>
                                                            <button type="submit" class="dropdown-item">Test Message</button>
                                                        </form>
                                                    </li>
                                                </t>
                                                <li><hr class="dropdown-divider"/></li>
                                                <li>
                                                    <form t-attf-action="/evolution/instances/delete/{{ rec.id }}" method="post">
                                                        <input type="hidden" name="csrf_token" t-att-value="csrf_token"/>
                                                        <button type="submit" class="dropdown-item text-danger">Delete</button>
                                                    </form>
                                                </li>
                                            </ul>
                                        </div>
                                    </td>
                                </tr>
                            </t>
                            <tr t-if="not records">
                                <td colspan="5" class="text-center text-muted">No records found.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <t t-foreach="records" t-as="rec">
                    <div class="modal fade" t-att-id="'qrModal%s' % rec.id" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered modal-lg">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title">Scan QR Code</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"/>
                                </div>
                                <div class="modal-body text-center">
                                    <img t-att-id="'qrImg%s' % rec.id" style="max-width: 420px; width: 100%; height: auto;" alt="QR Code"/>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="modal fade" t-att-id="'credModal%s' % rec.id" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title">Instance Credentials</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"/>
                                </div>
                                <div class="modal-body">
                                    <div class="alert alert-info">
                                        Use <b>Instance Key</b> as the <code>apikey</code> header for instance-scoped actions.
                                        Use <b>Instance ID</b> when an integration asks for instance identifier.
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">Evolution API URL</label>
                                        <input class="form-control" type="text" t-att-value="evolution_base_url or ''" readonly="readonly"/>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">Instance ID</label>
                                        <input class="form-control" type="text" t-att-value="rec.evo_instance_id or ''" readonly="readonly"/>
                                    </div>
                                    <div class="mb-0">
                                        <label class="form-label">Instance Key</label>
                                        <input class="form-control" type="text" t-att-value="rec.evo_instance_key or ''" readonly="readonly"/>
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>

                <script type="text/javascript"><![CDATA[
                    document.addEventListener('DOMContentLoaded', function () {
                        var buttons = document.querySelectorAll('.js-evo-get-qr');
                        buttons.forEach(function (btn) {
                            btn.addEventListener('click', function () {
                                if (btn.dataset.loading === '1') {
                                    return;
                                }
                                btn.dataset.loading = '1';
                                btn.disabled = true;
                                var originalText = btn.textContent;
                                btn.textContent = 'Loading...';
                                var recordId = btn.getAttribute('data-record-id');
                                var modalId = btn.getAttribute('data-modal-id');
                                fetch('/evolution/instances/qr/fetch', {
                                    method: 'POST',
                                    headers: { 'Content-Type': 'application/json' },
                                    body: JSON.stringify({
                                        jsonrpc: '2.0',
                                        method: 'call',
                                        params: { record_id: parseInt(recordId, 10) },
                                        id: parseInt(recordId, 10)
                                    })
                                }).then(function (r) { return r.json(); }).then(function (payload) {
                                    var result = payload.result || {};
                                    if (!result.ok) {
                                        window.alert(result.error || 'Failed to fetch QR code.');
                                        return;
                                    }
                                    var qrImage = result.qr_code_image || '';
                                    var qrText = result.qr_code_text || '';
                                    if (qrImage.slice(0, 2) === "b'" && qrImage.slice(-1) === "'") {
                                        qrImage = qrImage.slice(2, -1);
                                    }
                                    var img = document.getElementById('qrImg' + recordId);
                                    if (img) {
                                        if (qrImage) {
                                            img.src = 'data:image/png;base64,' + qrImage;
                                        } else if (qrText) {
                                            img.src = '/report/barcode/?type=QR&width=420&height=420&value=' + encodeURIComponent(qrText);
                                        } else {
                                            img.removeAttribute('src');
                                        }
                                    }
                                    var modalEl = document.getElementById(modalId);
                                    var previewSrc = '';
                                    if (img && img.src) {
                                        previewSrc = img.src;
                                    }
                                    if (modalEl) {
                                        if (window.bootstrap && window.bootstrap.Modal) {
                                            window.bootstrap.Modal.getOrCreateInstance(modalEl).show();
                                        } else if (window.jQuery && window.jQuery.fn && window.jQuery.fn.modal) {
                                            window.jQuery(modalEl).modal('show');
                                        } else {
                                            modalEl.style.display = 'block';
                                            modalEl.classList.add('show');
                                            modalEl.removeAttribute('aria-hidden');
                                            modalEl.setAttribute('aria-modal', 'true');
                                        }
                                    } else if (previewSrc) {
                                        window.open(previewSrc, '_blank');
                                    }
                                }).catch(function () {
                                    window.alert('Failed to fetch QR code.');
                                }).finally(function () {
                                    btn.dataset.loading = '0';
                                    btn.disabled = false;
                                    btn.textContent = originalText;
                                });
                            });
                        });
                    });
                ]]></script>
            </div>
        </t>
    </template>

    <record id="evolution_website_menu_instances" model="website.menu">
        <field name="name">Evolution Instances</field>
        <field name="url">/evolution/instances</field>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" eval="85"/>
    </record>
</odoo>
