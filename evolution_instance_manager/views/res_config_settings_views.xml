<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_form_evolution_instance" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.evolution.instance</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <group string="Evolution API">
                    <group>
                        <field name="evolution_base_url" placeholder="https://api.example.com"/>
                        <field name="evolution_server_api_key" password="True"/>
                        <field name="evolution_max_instances_per_user"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
