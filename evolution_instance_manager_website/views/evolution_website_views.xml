<?xml version="1.0" encoding="UTF-8"?>

<odoo>


<template id="evolution_instances_website_page" name="Evolution Instances Website Page">
    <t t-call="website.layout">

        <div class="container my-5">

            <!-- Page Header -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1 class="fw-bold mb-1">Evolution Instances</h1>
                    <p class="text-muted mb-0">Manage your WhatsApp Evolution API instances</p>
                </div>
            </div>

            <!-- Alerts -->
            <div t-if="success" class="alert alert-success">
                <t t-esc="success"/>
            </div>

            <div t-if="error" class="alert alert-danger">
                <t t-esc="error"/>
            </div>


            <!-- Create Instance Card -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body">

                    <h5 class="card-title fw-semibold mb-3">
                        Create New Instance
                    </h5>

                    <form action="/evolution/instances/create" method="post" class="row g-3">

                        <input type="hidden" name="csrf_token" t-att-value="csrf_token"/>

                        <div class="col-md-4">
                            <label class="form-label">Instance Name</label>
                            <input class="form-control" type="text" name="name" required="required"/>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Phone Number</label>
                            <input class="form-control"
                                   type="tel"
                                   name="pairing_phone"
                                   placeholder="+15551234567"
                                   required="required"/>
                        </div>

                        <div class="col-md-4 d-flex align-items-end">
                            <button type="submit" class="btn btn-primary w-100">
                                Create Instance
                            </button>
                        </div>

                    </form>

                </div>
            </div>


            <!-- Instances Table -->
            <div class="card shadow-sm border-0">
                <div class="table-responsive">

                    <table class="table table-hover mb-0">

                        <thead class="table-light">
                            <tr>
                                <th>Name</th>
                                <th>Phone</th>
                                <th>Status</th>
                                <th>Last Sync</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>

                        <tbody>

                            <t t-foreach="records" t-as="rec">

                                <tr>

                                    <td class="fw-semibold">
                                        <t t-esc="rec.name"/>
                                    </td>

                                    <td>
                                        <t t-esc="rec.pairing_phone or '-'"/>
                                    </td>

                                    <!-- Status Badge -->
                                    <td>

                                        <span t-att-class="
                                            'badge text-bg-success' if rec.status == 'open'
                                            else 'badge text-bg-warning' if rec.status == 'connecting'
                                            else 'badge text-bg-secondary'
                                        ">
                                            <t t-esc="rec.status or '-'"/>
                                        </span>

                                    </td>

                                    <td class="text-nowrap">
                                        <t t-esc="rec.last_status_sync_at or '-'"/>
                                    </td>


                                    <!-- Actions -->
                                    <td class="text-end">

                                        <div class="btn-group btn-group-sm">

                                            <t t-if="rec.status != 'open'">
                                                <button type="button"
                                                    class="btn btn-outline-primary js-evo-get-qr"
                                                    title="Get QR"
                                                    t-att-data-record-id="rec.id"
                                                    t-att-data-modal-id="'qrModal%s' % rec.id">
                                                    QR
                                                </button>
                                            </t>

                                            <t t-if="rec.status == 'open'">
                                                <button class="btn btn-outline-secondary"
                                                    title="Credentials"
                                                    type="button"
                                                    t-att-data-bs-target="'#credModal%s' % rec.id"
                                                    data-bs-toggle="modal">
                                                    Credentials
                                                </button>
                                            </t>

                                            <t t-if="rec.status == 'open'">
                                                <form t-attf-action="/evolution/instances/test/{{ rec.id }}" method="post">
                                                    <input type="hidden" name="csrf_token" t-att-value="csrf_token"/>
                                                    <button type="submit" class="btn btn-outline-success">
                                                        Test
                                                    </button>
                                                </form>
                                            </t>

                                            <form t-attf-action="/evolution/instances/delete/{{ rec.id }}" method="post"
                                                  onsubmit="return confirm('Delete this instance?');">

                                                <input type="hidden" name="csrf_token" t-att-value="csrf_token"/>

                                                <button type="submit" class="btn btn-outline-danger">
                                                    Delete
                                                </button>

                                            </form>

                                        </div>

                                    </td>

                                </tr>

                            </t>


                            <!-- Empty State -->
                            <tr t-if="not records">
                                <td colspan="5" class="text-center text-muted py-5">
                                    <h6 class="mb-1">No Instances Yet</h6>
                                    <div>Create your first instance above.</div>
                                </td>
                            </tr>

                        </tbody>

                    </table>

                </div>
            </div>



            <!-- QR MODALS -->
            <t t-foreach="records" t-as="rec">

                <div class="modal fade"
                     t-att-id="'qrModal%s' % rec.id"
                     tabindex="-1"
                     aria-hidden="true">

                    <div class="modal-dialog modal-dialog-centered modal-lg">

                        <div class="modal-content">

                            <div class="modal-header">
                                <h5 class="modal-title">Scan QR Code</h5>
                                <button type="button"
                                        class="btn-close"
                                        data-bs-dismiss="modal"/>
                            </div>

                            <div class="modal-body text-center p-4">

                                <img t-att-id="'qrImg%s' % rec.id"
                                     style="max-width:420px;width:100%;border-radius:10px;"
                                     alt="QR Code"/>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- Credentials Modal -->
                <div class="modal fade"
                     t-att-id="'credModal%s' % rec.id"
                     tabindex="-1"
                     aria-hidden="true">

                    <div class="modal-dialog modal-dialog-centered">

                        <div class="modal-content">

                            <div class="modal-header">
                                <h5 class="modal-title">Instance Credentials</h5>
                                <button type="button"
                                        class="btn-close"
                                        data-bs-dismiss="modal"/>
                            </div>

                            <div class="modal-body">

                                <div class="alert alert-info">
                                    Use <b>Instance Key</b> as API key.
                                </div>

                                <div class="mb-3">

                                    <label class="form-label">Instance ID</label>

                                    <div class="input-group">

                                        <input t-att-id="'id%s' % rec.id"
                                               class="form-control"
                                               type="password"
                                               t-att-value="rec.evo_instance_id or ''"
                                               readonly="readonly"/>

                                        <button class="btn btn-outline-secondary"
                                            type="button"
                                            t-att-data-target="'id%s' % rec.id"
                                            onclick="toggleSecret(this)">
                                            👁
                                        </button>

                                        <button class="btn btn-outline-secondary"
                                            type="button"
                                            t-att-data-target="'id%s' % rec.id"
                                            onclick="copySecret(this)">
                                            📋
                                        </button>

                                    </div>

                                </div>


                                <div class="mb-0">

                                    <label class="form-label">Instance Key</label>

                                    <div class="input-group">

                                        <input t-att-id="'key%s' % rec.id"
                                               class="form-control"
                                               type="password"
                                               t-att-value="rec.evo_instance_key or ''"
                                               readonly="readonly"/>

                                        <button class="btn btn-outline-secondary"
                                            type="button"
                                            t-att-data-target="'key%s' % rec.id"
                                            onclick="toggleSecret(this)">
                                            👁
                                        </button>

                                        <button class="btn btn-outline-secondary"
                                            type="button"
                                            t-att-data-target="'key%s' % rec.id"
                                            onclick="copySecret(this)">
                                            📋
                                        </button>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </t>


            <!-- JS -->
            <script>

                function toggleSecret(btn){
                    const id = btn.dataset.target;
                    const el = document.getElementById(id);
                    if(!el) return;
                    el.type = el.type === "password" ? "text" : "password";
                }

                function copySecret(btn){
                    const id = btn.dataset.target;
                    const el = document.getElementById(id);
                    if(!el) return;
                    navigator.clipboard.writeText(el.value);
                    btn.innerText = "Copied";
                    setTimeout(()=>btn.innerText="📋",800);
                }

            </script>

        </div>

    </t>
</template>


<record id="evolution_website_menu_instances" model="website.menu">
    <field name="name">Evolution Instances</field>
    <field name="url">/evolution/instances</field>
    <field name="parent_id" ref="website.main_menu"/>
    <field name="sequence" eval="85"/>
</record>


</odoo>
