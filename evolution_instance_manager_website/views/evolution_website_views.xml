<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="evolution_instances_website_page" name="Evolution Instances Website Page">
        <t t-call="website.layout">
            <div class="container my-5">
                <h1 class="mb-4">Evolution Instances</h1>
                <div t-if="success" class="alert alert-success" role="alert">
                    <t t-esc="success"/>
                </div>
                <div t-if="error" class="alert alert-danger" role="alert">
                    <t t-esc="error"/>
                </div>

                <div class="card mb-4">
                    <div class="card-body">
                        <h5 class="card-title mb-3">Create New Instance</h5>
                        <form action="/evolution/instances/create" method="post" class="row g-3">
                            <input type="hidden" name="csrf_token" t-att-value="csrf_token"/>
                            <div class="col-md-3">
                                <label class="form-label">Name</label>
                                <input class="form-control" type="text" name="name" required="required"/>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Instance Name</label>
                                <input class="form-control" type="text" name="evo_instance_name" required="required"/>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Pairing Phone</label>
                                <input class="form-control" type="text" name="pairing_phone" placeholder="+15551234567" required="required"/>
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">Integration</label>
                                <select class="form-select" name="integration">
                                    <option value="WHATSAPP-BAILEYS">WHATSAPP-BAILEYS</option>
                                    <option value="WHATSAPP-BUSINESS">WHATSAPP-BUSINESS</option>
                                </select>
                            </div>
                            <div class="col-md-1 d-flex align-items-end">
                                <button type="submit" class="btn btn-primary w-100">Create</button>
                            </div>
                        </form>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Instance Name</th>
                                <th>Status</th>
                                <th>Last Sync</th>
                                <th class="text-end">Open</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="records" t-as="rec">
                                <tr>
                                    <td><t t-esc="rec.name"/></td>
                                    <td><t t-esc="rec.evo_instance_name"/></td>
                                    <td><t t-esc="rec.status or '-'"/></td>
                                    <td><t t-esc="rec.last_status_sync_at or '-'"/></td>
                                    <td class="text-end">
                                        <a t-attf-href="/web#id={{ rec.id }}&amp;model=evolution.instance.account&amp;view_type=form" class="btn btn-sm btn-primary">
                                            Open in Backend
                                        </a>
                                    </td>
                                </tr>
                            </t>
                            <tr t-if="not records">
                                <td colspan="5" class="text-center text-muted">No records found.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </t>
    </template>

    <record id="evolution_website_menu_instances" model="website.menu">
        <field name="name">Evolution Instances</field>
        <field name="url">/evolution/instances</field>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" eval="85"/>
    </record>
</odoo>
