<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="evolution_instances_website_page" name="Evolution Instances Website Page">
        <t t-call="website.layout">
            <div class="container my-5">
                <h1 class="mb-4">Evolution Instances</h1>
                <div t-if="success" class="alert alert-success" role="alert">
                    <t t-esc="success"/>
                </div>
                <div t-if="error" class="alert alert-danger" role="alert">
                    <t t-esc="error"/>
                </div>

                <div class="card mb-4">
                    <div class="card-body">
                        <h5 class="card-title mb-3">Create New Instance</h5>
                        <form action="/evolution/instances/create" method="post" class="row g-3">
                            <input type="hidden" name="csrf_token" t-att-value="csrf_token"/>
                            <div class="col-md-5">
                                <label class="form-label">Name</label>
                                <input class="form-control" type="text" name="name" required="required"/>
                            </div>
                            <div class="col-md-5">
                                <label class="form-label">Phone</label>
                                <input class="form-control" type="text" name="pairing_phone" placeholder="+15551234567" required="required"/>
                            </div>
                            <div class="col-md-2 d-flex align-items-end">
                                <button type="submit" class="btn btn-primary w-100">Create</button>
                            </div>
                        </form>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Phone</th>
                                <th>Status</th>
                                <th>Last Sync</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="records" t-as="rec">
                                <tr>
                                    <td><t t-esc="rec.name"/></td>
                                    <td><t t-esc="rec.pairing_phone or '-'"/></td>
                                    <td><t t-esc="rec.status or '-'"/></td>
                                    <td><t t-esc="rec.last_status_sync_at or '-'"/></td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-secondary me-1" type="button" t-att-data-bs-target="'#credModal%s' % rec.id" data-bs-toggle="modal">
                                            ID/Key
                                        </button>
                                        <t t-if="rec.status != 'open'">
                                            <button type="button" class="btn btn-sm btn-info me-1 js-evo-get-qr" t-att-data-record-id="rec.id" t-att-data-modal-id="'qrModal%s' % rec.id">Get QR</button>
                                        </t>
                                        <form t-attf-action="/evolution/instances/delete/{{ rec.id }}" method="post" class="d-inline">
                                            <input type="hidden" name="csrf_token" t-att-value="csrf_token"/>
                                            <button type="submit" class="btn btn-sm btn-danger me-1">Delete</button>
                                        </form>
                                        <a t-attf-href="/web#id={{ rec.id }}&amp;model=evolution.instance.account&amp;view_type=form" class="btn btn-sm btn-primary">
                                            Open in Backend
                                        </a>
                                    </td>
                                </tr>
                            </t>
                            <tr t-if="not records">
                                <td colspan="5" class="text-center text-muted">No records found.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <t t-foreach="records" t-as="rec">
                    <div class="modal fade" t-att-id="'qrModal%s' % rec.id" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered modal-lg">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title">Scan QR Code</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"/>
                                </div>
                                <div class="modal-body text-center">
                                    <img t-att-id="'qrImg%s' % rec.id" t-if="rec.qr_code_image" t-att-src="'data:image/png;base64,%s' % rec.qr_code_image" style="max-width: 420px; width: 100%; height: auto;" alt="QR Code"/>
                                    <img t-att-id="'qrImg%s' % rec.id" t-if="not rec.qr_code_image" style="display:none; max-width: 420px; width: 100%; height: auto;" alt="QR Code"/>
                                    <p t-if="not rec.qr_code_image" class="text-muted mb-0">No QR available. Click Get QR first.</p>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="modal fade" t-att-id="'credModal%s' % rec.id" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title">Instance Credentials</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"/>
                                </div>
                                <div class="modal-body">
                                    <div class="mb-3">
                                        <label class="form-label">Instance ID</label>
                                        <input class="form-control" type="text" t-att-value="rec.evo_instance_id or ''" readonly="readonly"/>
                                    </div>
                                    <div class="mb-0">
                                        <label class="form-label">Instance Key</label>
                                        <input class="form-control" type="text" t-att-value="rec.evo_instance_key or ''" readonly="readonly"/>
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>

                <script type="text/javascript">
                    document.addEventListener('DOMContentLoaded', function () {
                        var buttons = document.querySelectorAll('.js-evo-get-qr');
                        buttons.forEach(function (btn) {
                            btn.addEventListener('click', function () {
                                var recordId = btn.getAttribute('data-record-id');
                                var modalId = btn.getAttribute('data-modal-id');
                                fetch('/evolution/instances/qr/fetch', {
                                    method: 'POST',
                                    headers: { 'Content-Type': 'application/json' },
                                    body: JSON.stringify({
                                        jsonrpc: '2.0',
                                        method: 'call',
                                        params: { record_id: parseInt(recordId, 10) },
                                        id: parseInt(recordId, 10)
                                    })
                                }).then(function (r) { return r.json(); }).then(function (payload) {
                                    var result = payload.result || {};
                                    if (!result.ok) {
                                        window.alert(result.error || 'Failed to fetch QR code.');
                                        return;
                                    }
                                    var qrImage = result.qr_code_image || '';
                                    if (qrImage.slice(0, 2) === "b'" &amp;&amp; qrImage.slice(-1) === "'") {
                                        qrImage = qrImage.slice(2, -1);
                                    }
                                    var img = document.getElementById('qrImg' + recordId);
                                    if (img) {
                                        img.src = 'data:image/png;base64,' + qrImage;
                                        img.style.display = '';
                                    }
                                    var modalEl = document.getElementById(modalId);
                                    if (modalEl &amp;&amp; window.bootstrap &amp;&amp; window.bootstrap.Modal) {
                                        window.bootstrap.Modal.getOrCreateInstance(modalEl).show();
                                    }
                                }).catch(function () {
                                    window.alert('Failed to fetch QR code.');
                                });
                            });
                        });
                    });
                </script>
            </div>
        </t>
    </template>

    <record id="evolution_website_menu_instances" model="website.menu">
        <field name="name">Evolution Instances</field>
        <field name="url">/evolution/instances</field>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" eval="85"/>
    </record>
</odoo>
