<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="whatsapp_evaluation_template_view_form" model="ir.ui.view">
        <field name="name">whatsapp_evaluation.template.view.form</field>
        <field name="model">whatsapp_evaluation.template</field>
        <field name="arch" type="xml">
            <form string="WhatsApp Template">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="model_id"/>
                    </group>
                    <group>
                        <field name="body"/>
                    </group>
                    <!-- <notebook>
                        <page string="Variables">
                            <field name="variable_ids">
                                <tree editable="bottom">
                                    <field name="name"/>
                                    <field name="line_type" invisible="1"/>
                                    <field name="field_type"/>
                                    <field name="field_name" invisible="field_type != 'field'" required="field_type == 'field'"/>
                                    <field name="demo_value"/>
                                </tree>
                            </field>
                        </page>
                    </notebook> -->
                </sheet>
            </form>
        </field>
    </record>

    <record id="whatsapp_evaluation_template_view_list" model="ir.ui.view">
        <field name="name">whatsapp_evaluation.template.view.list</field>
        <field name="model">whatsapp_evaluation.template</field>
        <field name="arch" type="xml">
            <list string="WhatsApp Templates">
                <field name="name"/>
                <field name="model"/>
            </list>
        </field>
    </record>

    <record id="whatsapp_evaluation_template_action" model="ir.actions.act_window">
        <field name="name">WhatsApp Templates</field>
        <field name="res_model">whatsapp_evaluation.template</field>
        <field name="view_mode">list,form</field>
    </record>
    
    <menuitem id="whatsapp_evaluation_template_menu"
              name="Templates"
              parent="whatsapp_evaluation_menu_root"
              action="whatsapp_evaluation_template_action"
              sequence="20"/>
</odoo>
