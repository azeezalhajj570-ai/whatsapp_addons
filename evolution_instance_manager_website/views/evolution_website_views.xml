<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="evolution_instances_website_page" name="Evolution Instances Website Page">
        <t t-call="website.layout">
            <section class="o_we_section py-5">
                <div class="container o_container_small">
                    <div class="mb-4">
                        <h2 class="fw-bold">Evolution Instances</h2>
                        <p class="text-muted mb-0">Manage your WhatsApp Evolution API connections</p>
                    </div>

                    <div t-if="success" class="alert alert-success">
                        <t t-esc="success"/>
                    </div>
                    <div t-if="error" class="alert alert-danger">
                        <t t-esc="error"/>
                    </div>

                    <div class="o_card mb-4">
                        <div class="card-body">
                            <h5 class="card-title mb-3">Create Instance</h5>
                            <form action="/evolution/instances/create" method="post" class="row g-3">
                                <input type="hidden" name="csrf_token" t-att-value="csrf_token"/>
                                <div class="col-12 col-md-5">
                                    <label class="form-label">Name</label>
                                    <input class="form-control" type="text" name="name" required="required"/>
                                </div>
                                <div class="col-12 col-md-5">
                                    <label class="form-label">Phone</label>
                                    <input class="form-control" type="tel" name="pairing_phone" placeholder="+15551234567" required="required"/>
                                </div>
                                <div class="col-12 col-md-2 d-grid">
                                    <button type="submit" class="btn btn-primary">Create</button>
                                </div>
                            </form>
                        </div>
                    </div>

                    <div class="o_card">
                        <div class="table-responsive">
                            <table class="table o_table table-hover mb-0">
                                <thead>
                                    <tr>
                                        <th>Name</th>
                                        <th>Phone</th>
                                        <th>Status</th>
                                        <th>Last Sync</th>
                                        <th class="text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="records" t-as="rec">
                                        <tr>
                                            <td class="fw-semibold">
                                                <t t-esc="rec.name"/>
                                            </td>
                                            <td>
                                                <t t-esc="rec.pairing_phone or '-'"/>
                                            </td>
                                            <td>
                                                <span t-att-class="'badge bg-success' if rec.status == 'open' else 'badge bg-warning text-dark' if rec.status == 'connecting' else 'badge bg-secondary'">
                                                    <t t-esc="rec.status or '-'"/>
                                                </span>
                                            </td>
                                            <td class="text-nowrap">
                                                <t t-esc="rec.last_status_sync_at or '-'"/>
                                            </td>
                                            <td class="text-end">
                                                <div class="btn-group btn-group-sm">
                                                    <t t-if="rec.status != 'open'">
                                                        <button type="button" class="btn btn-outline-primary js-evo-get-qr" t-att-data-record-id="rec.id" t-att-data-modal-id="'qrModal%s' % rec.id">
                                                            QR
                                                        </button>
                                                    </t>
                                                    <t t-if="rec.status == 'open'">
                                                        <button class="btn btn-outline-secondary" type="button" t-att-data-bs-target="'#credModal%s' % rec.id" data-bs-toggle="modal">
                                                            Credentials
                                                        </button>
                                                    </t>
                                                    <form t-attf-action="/evolution/instances/delete/{{ rec.id }}" method="post" class="d-inline">
                                                        <input type="hidden" name="csrf_token" t-att-value="csrf_token"/>
                                                        <button type="submit" class="btn btn-outline-danger">Delete</button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    </t>
                                    <tr t-if="not records">
                                        <td colspan="5" class="text-center py-5 text-muted">No instances created yet.</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <t t-foreach="records" t-as="rec">
                        <div class="modal fade" t-att-id="'qrModal%s' % rec.id" tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title">Scan QR Code</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal"/>
                                    </div>
                                    <div class="modal-body text-center">
                                        <img t-att-id="'qrImg%s' % rec.id" style="max-width:420px;width:100%;" alt="QR Code"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="modal fade" t-att-id="'credModal%s' % rec.id" tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title">Instance Credentials</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal"/>
                                    </div>
                                    <div class="modal-body">
                                        <div class="alert alert-info">
                                            Use <b>Instance Key</b> as the API key.
                                            <br/>
                                            Evolution API URL:
                                            <code>
                                                <t t-esc="evolution_base_url or '-'"/>
                                            </code>
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label">Instance ID</label>
                                            <div class="input-group">
                                                <input t-att-id="'id%s' % rec.id" class="form-control" type="password" t-att-value="rec.evo_instance_id or ''" readonly="readonly"/>
                                                <button class="btn btn-outline-secondary" type="button" t-att-data-target="'id%s' % rec.id" onclick="toggleSecret(this)">Show</button>
                                                <button class="btn btn-outline-secondary" type="button" t-att-data-target="'id%s' % rec.id" onclick="copySecret(this)">Copy</button>
                                            </div>
                                        </div>

                                        <div class="mb-0">
                                            <label class="form-label">Instance Key</label>
                                            <div class="input-group">
                                                <input t-att-id="'key%s' % rec.id" class="form-control" type="password" t-att-value="rec.evo_instance_key or ''" readonly="readonly"/>
                                                <button class="btn btn-outline-secondary" type="button" t-att-data-target="'key%s' % rec.id" onclick="toggleSecret(this)">Show</button>
                                                <button class="btn btn-outline-secondary" type="button" t-att-data-target="'key%s' % rec.id" onclick="copySecret(this)">Copy</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>

                    <script>
                        function toggleSecret(btn) {
                            const id = btn.dataset.target;
                            const el = document.getElementById(id);
                            if (!el) return;
                            el.type = el.type === "password" ? "text" : "password";
                            btn.innerText = el.type === "password" ? "Show" : "Hide";
                        }

                        function copySecret(btn) {
                            const id = btn.dataset.target;
                            const el = document.getElementById(id);
                            if (!el) return;
                            navigator.clipboard.writeText(el.value || "");
                            btn.innerText = "Copied";
                            setTimeout(function () { btn.innerText = "Copy"; }, 900);
                        }

                        document.addEventListener("DOMContentLoaded", function () {
                            const buttons = document.querySelectorAll(".js-evo-get-qr");
                            buttons.forEach(function (btn) {
                                btn.addEventListener("click", async function () {
                                    const recordId = parseInt(btn.dataset.recordId, 10);
                                    const modalId = btn.dataset.modalId;
                                    if (!recordId || !modalId) return;

                                    const img = document.getElementById("qrImg" + recordId);
                                    const modalEl = document.getElementById(modalId);
                                    if (!img || !modalEl) return;

                                    btn.disabled = true;
                                    const originalText = btn.innerText;
                                    btn.innerText = "Loading...";

                                    try {
                                        const response = await fetch("/evolution/instances/qr/fetch", {
                                            method: "POST",
                                            headers: {
                                                "Content-Type": "application/json"
                                            },
                                            body: JSON.stringify({ record_id: recordId })
                                        });
                                        const payload = await response.json();
                                        const result = payload && payload.result ? payload.result : payload;
                                        if (!result || !result.ok) {
                                            throw new Error((result && result.error) || "Failed to fetch QR code.");
                                        }

                                        const qrImage = result.qr_code_image || "";
                                        const qrText = result.qr_code_text || "";
                                        if (qrImage) {
                                            const normalized = qrImage.startsWith("data:image") ? qrImage : ("data:image/png;base64," + qrImage);
                                            img.setAttribute("src", normalized);
                                        } else if (qrText) {
                                            const encoded = encodeURIComponent(qrText);
                                            img.setAttribute("src", "https://api.qrserver.com/v1/create-qr-code/?size=420x420&data=" + encoded);
                                        } else {
                                            throw new Error("No QR data returned by server.");
                                        }

                                        const modal = window.bootstrap ? new bootstrap.Modal(modalEl) : null;
                                        if (modal) modal.show();
                                    } catch (err) {
                                        alert((err && err.message) || "Failed to fetch QR code.");
                                    } finally {
                                        btn.disabled = false;
                                        btn.innerText = originalText;
                                    }
                                });
                            });
                        });
                    </script>
                </div>
            </section>
        </t>
    </template>

    <record id="evolution_website_menu_instances" model="website.menu">
        <field name="name">Evolution Instances</field>
        <field name="url">/evolution/instances</field>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" eval="85"/>
    </record>
</odoo>
