<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_form_evolution_instance" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.evolution.instance</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block" data-string="Evolution API" data-key="evolution_instance_manager">
                    <h2>Evolution API</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="evolution_base_url"/>
                                <div class="text-muted">Base URL of your Evolution API server.</div>
                                <div class="mt16">
                                    <field name="evolution_base_url" placeholder="https://api.example.com"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="evolution_server_api_key"/>
                                <div class="text-muted">Server API key used for instance management.</div>
                                <div class="mt16">
                                    <field name="evolution_server_api_key" password="True"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
