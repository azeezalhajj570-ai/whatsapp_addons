<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_actions_server_view_form_inherit_whatsapp_ai" model="ir.ui.view">
        <field name="name">ir.actions.server.view.form.inherit.whatsapp.ai</field>
        <field name="model">ir.actions.server</field>
        <field name="inherit_id" ref="ai.ir_actions_server_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='ai_model_id']" position="after">
                <field name="ai_provider_code"/>
                <field name="ai_model_name"/>
            </xpath>
        </field>
    </record>
</odoo>
