<?xml version="1.0"?>
<odoo noupdate="0">
    <record id="whatsapp_evaluation_template_sale_order" model="whatsapp_evaluation.template">
        <field name="name">Sale Order</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="header_type">document</field>
        <field name="report_id" ref="sale.action_report_saleorder"/>
        <field name="body">Hello {{1}},

Congratulations! Your order *{{2}}* from *{{3}}* has been confirmed for a total of *{{4}}{{5}}*.

To track your order: {{6}}

Thank you.</field>
        <field name="variable_ids" eval="[
            (5, 0, 0),
            (0, 0, {
                'name': '{{1}}',
                'demo_value': 'Azure Interior',
                'line_type': 'body',
                'field_type': 'field',
                'field_name': 'partner_id'
            }),
            (0, 0, {
                'name': '{{2}}',
                'demo_value': 'SO00025',
                'line_type': 'body',
                'field_type': 'field',
                'field_name': 'name'
            }),
            (0, 0, {
                'name': '{{3}}',
                'demo_value': 'My Company',
                'line_type': 'body',
                'field_type': 'field',
                'field_name': 'company_id'
            }),
            (0, 0, {
                'name': '{{4}}',
                'demo_value': '$',
                'line_type': 'body',
                'field_type': 'field',
                'field_name': 'currency_id.symbol'
            }),
            (0, 0, {
                'name': '{{5}}',
                'demo_value': '1000',
                'line_type': 'body',
                'field_type': 'field',
                'field_name': 'amount_total'
            }),
            (0, 0, {
                'name': '{{6}}',
                'demo_value': 'https://...',
                'line_type': 'body',
                'field_type': 'portal_url'
            })
        ]" />
    </record>

